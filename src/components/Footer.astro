---
const currentYear = new Date().getFullYear();
---

<footer class="bg-stone-950 text-stone-400 py-8 border-t border-stone-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row justify-between items-center gap-4">
            <div class="text-center md:text-left">
                <span class="text-lg font-serif font-bold text-white block">La Terrazza</span>
                <span class="text-sm">© {currentYear} Tutti i diritti riservati.</span>
            </div>
            
            <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6">
                <div class="flex gap-6">
                    <a href="/privacy-policy" class="hover:text-white transition-colors text-sm">Privacy Policy</a>
                    <a href="/cookie-policy" class="hover:text-white transition-colors text-sm">Cookie Policy</a>
                </div>
                <div class="text-sm flex items-center gap-1">
                    <span>Partner digitale:</span>
                    <a href="https://bitora.it" target="_blank" rel="noopener noreferrer" class="text-olive-500 hover:text-olive-400 font-medium transition-colors">
                        bitora.it
                    </a>
                </div>
            </div>
        </div>
    </div>
</footer>