---
import { menuData } from '../data/menu';

const formatPrice = (price: number) => {
  return new Intl.NumberFormat('it-IT', { style: 'currency', currency: 'EUR' }).format(price);
};
---

<section id="menu" class="py-20 bg-stone-50">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <h2 class="text-4xl font-bold text-stone-800 mb-4">Il Nostro Menu</h2>
      <div class="w-20 h-1 bg-olive-600 mx-auto mb-8"></div>
      <p class="mt-4 text-stone-600 mb-8">Scopri le nostre specialità di terra e di mare</p>
      
      <a href="/menu.pdf" download class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-olive-600 hover:bg-olive-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-olive-500 shadow-sm transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        Visualizza il Menu in PDF
      </a>
    </div>

    <!-- Antipasti -->
    <div class="text-center mb-12 mt-16">
        <h3 class="text-3xl font-bold text-stone-800 mb-2 font-serif">Antipasti</h3>
        <div class="w-16 h-1 bg-olive-600 mx-auto"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h4 class="text-xl font-bold text-olive-700 mb-6 mt-8 border-b border-olive-200 pb-2 inline-block">Terra</h4>
        {menuData.antipasti.terra.map(item => (
            <div class="mb-6 break-inside-avoid">
                <div class="flex justify-between items-baseline mb-1">
                <h5 class="text-lg font-bold text-stone-800">{item.name}</h5>
                <span class="text-olive-600 font-bold ml-4">{formatPrice(item.price_eur)}</span>
                </div>
                {item.description && <p class="text-stone-600 text-sm italic">{item.description}</p>}
            </div>
        ))}
      </div>
      <div>
        <h4 class="text-xl font-bold text-olive-700 mb-6 mt-8 border-b border-olive-200 pb-2 inline-block">Mare</h4>
        {menuData.antipasti.mare.map(item => (
            <div class="mb-6 break-inside-avoid">
                <div class="flex justify-between items-baseline mb-1">
                <h5 class="text-lg font-bold text-stone-800">{item.name}</h5>
                <span class="text-olive-600 font-bold ml-4">{formatPrice(item.price_eur)}</span>
                </div>
                {item.description && <p class="text-stone-600 text-sm italic">{item.description}</p>}
