        <div class="w-16 h-1 bg-olive-600 mx-auto"></div>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
      <div>
        <h4 class="text-xl font-bold text-olive-700 mb-6 mt-8 border-b border-olive-200 pb-2 inline-block">Dolci</h4>
        {menuData.dessert.map(item => (
            <div class="mb-6 break-inside-avoid">
                <div class="flex justify-between items-baseline mb-1">
                <h5 class="text-lg font-bold text-stone-800">{item.name}</h5>
                <span class="text-olive-600 font-bold ml-4">{formatPrice(item.price_eur)}</span>
                </div>
            </div>
        ))}
      </div>
      <div>
        <h4 class="text-xl font-bold text-olive-700 mb-6 mt-8 border-b border-olive-200 pb-2 inline-block">Caffetteria e Amari</h4>
        {menuData.caffe_e_amari.map(item => (
