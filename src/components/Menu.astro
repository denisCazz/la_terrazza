                <span class="text-olive-600 font-bold ml-4">{formatPrice(item.price_eur)}</span>
                </div>
            </div>
        ))}
        <div class="mt-8 p-4 bg-olive-50 rounded-lg border border-olive-100 text-center">
            <span class="font-bold text-stone-800">Coperto: </span>
            <span class="text-olive-600 font-bold">{formatPrice(menuData.coperto_e_note.coperto_eur)}</span>
            <p class="text-sm text-stone-600 mt-2 italic">{menuData.coperto_e_note.note}</p>
        </div>
      </div>
