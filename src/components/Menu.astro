      <div>
        <h4 class="text-xl font-bold text-olive-700 mb-6 mt-8 border-b border-olive-200 pb-2 inline-block">Mare</h4>
        {menuData.secondi.mare.map(item => (
            <div class="mb-6 break-inside-avoid">
                <div class="flex justify-between items-baseline mb-1">
                <h5 class="text-lg font-bold text-stone-800">{item.name}</h5>
                <span class="text-olive-600 font-bold ml-4">{formatPrice(item.price_eur)}</span>
                </div>
                {item.description && <p class="text-stone-600 text-sm italic">{item.description}</p>}
