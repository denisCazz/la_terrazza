const payments = [
  { name: "American Express", icon: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" },
  { name: "Contanti", icon: "M12 6v12m-3-2.818l.879.659c1.171.879 3.07.879 4.242 0 1.172-.879 1.172-2.303 0-3.182C13.536 12.219 12.768 12 12 12c-.725 0-1.45-.22-2.003-.659-1.106-.879-1.106-2.303 0-3.182s2.9-.879 4.006 0l.415.33M21 12a9 9 0 11-18 0 9 9 0 0118 0z" },
  { name: "Contactless", icon: "M8.288 15.038a5.25 5.25 0 017.424 0M5.106 11.856c3.807-3.808 9.98-3.808 13.788 0M1.924 8.674c5.565-5.565 14.587-5.565 20.152 0M12.53 18.22l-.53.53-.53-.53a.75.75 0 011.06 0z" },
  { name: "Mastercard", icon: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" },
  { name: "VISA", icon: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" },
  { name: "Carta di debito", icon: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" },
  { name: "Apple Pay", icon: "M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3" },
  { name: "Maestro", icon: "M2.25 8.25h19.5M2.25 9h19.5m-16.5 5.25h6m-6 2.25h3m-3.75 3h15a2.25 2.25 0 002.25-2.25V6.75A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25v10.5A2.25 2.25 0 004.5 19.5z" },
];

const schema = {
  "@context": "https://schema.org",
  "@type": "Restaurant",
  "name": "Pizzeria Ristorante La Terrazza",
  "image": "https://laterrazzacarmagnola.it/foto_orizzontale.jpg",
  "url": "https://laterrazzacarmagnola.it",
  "telephone": "+390119711419",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Via Susa 16",
    "addressLocality": "Carmagnola",
    "postalCode": "10022",
    "addressRegion": "TO",
    "addressCountry": "IT"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 44.8465, 
    "longitude": 7.7195 
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "18:30",
      "closes": "23:00"
    }
  ],
  "servesCuisine": "Italian, Pizza",
  "priceRange": "€€",
  "sameAs": [
    "https://www.instagram.com/pizzeria_la_terrazza_di_pisano"
  ]
};
---

<Layout 
    title="Pizzeria Ristorante La Terrazza | Carmagnola - Ex Tap-in"
    description="Benvenuti alla Pizzeria Ristorante La Terrazza a Carmagnola (ex Tap-in). Gusta la vera pizza italiana e piatti della tradizione in un ambiente rinnovato."
>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />

	<!-- Navigation -->
	<Navbar />

	<!-- Hero Section -->
	<section id="home" class="relative h-screen flex items-center justify-center bg-stone-900 text-white overflow-hidden">
		<div class="absolute inset-0 z-0">
			<img 
                src="/foto_orizzontale.jpg" 
                alt="Ristorante background" 
                class="w-full h-full object-cover opacity-40 animate-zoom-in"
            />
		</div>
		<div class="relative z-10 text-center px-4 max-w-4xl mx-auto">
			<h1 class="text-5xl md:text-7xl font-bold mb-6 leading-tight animate-slide-up">Pizzeria Ristorante<br/>La Terrazza</h1>
			<p class="text-xl md:text-2xl mb-10 font-light italic animate-slide-up-delay-1">"Dove la tradizione incontra il gusto autentico"</p>
			<div class="flex flex-col sm:flex-row gap-4 justify-center animate-slide-up-delay-2">
				<a href="tel:+390119711419" class="bg-olive-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-olive-700 transition-colors shadow-lg hover:scale-105 transform duration-200">Chiama ora</a>
				<a href="/menu" class="bg-transparent border-2 border-white text-white px-8 py-4 rounded-full text-lg font-semibold hover:bg-white hover:text-stone-900 transition-colors hover:scale-105 transform duration-200">Menu</a>
			</div>
		</div>
	</section>

	<!-- About Section -->
	<section id="about" class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6 animate-on-scroll">
					<h2 class="text-4xl font-bold text-stone-800">Chi Siamo</h2>
					<p class="text-xl text-stone-600 italic">"Non esiste amore più sincero di quello per il cibo."</p>
					<div class="w-20 h-1 bg-olive-600"></div>
					<p class="text-stone-600 leading-relaxed">
						Benvenuti alla Pizzeria Ristorante La Terrazza.
						Vi accogliamo in una location curata e accogliente, con un menù ricco di specialità e ingredienti di prima qualità!
					</p>
					<p class="text-stone-600 leading-relaxed">
						Venite a trovarci per assaporare le nostre prelibatezze, dalla pizza croccante ai piatti della tradizione.
					</p>
				</div>
				<div class="grid grid-cols-2 gap-4 animate-on-scroll">
					<img src="/foto1.jpg" alt="Pizza cotta nel forno a legna" class="rounded-lg shadow-md w-full h-64 object-cover transform translate-y-8 hover:scale-105 transition-transform duration-500">
					<img src="/foto2.jpg" alt="Piatto di pasta fresca con frutti di mare" class="rounded-lg shadow-md w-full h-64 object-cover hover:scale-105 transition-transform duration-500">
				</div>
			</div>
		</div>
	</section>

	<!-- Gallery Teaser -->
	<section class="py-20 bg-olive-900 text-white relative overflow-hidden">
		<div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-on-scroll">
			<h2 class="text-4xl font-serif font-bold mb-6">La Nostra Galleria</h2>
			<p class="text-xl text-olive-100 mb-8 max-w-2xl mx-auto">
				Scopri l'atmosfera unica del nostro locale e la passione che mettiamo in ogni piatto.
			</p>
			<a href="/galleria" class="inline-block bg-white text-olive-900 px-8 py-3 rounded-full font-semibold hover:bg-olive-50 transition-colors hover:scale-105 transform duration-200 shadow-lg">
				Guarda le Foto
			</a>
		</div>
	</section>

	<!-- Services Section -->
	<section id="services" class="py-20 bg-stone-100">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="text-center mb-16 animate-on-scroll">
				<h2 class="text-4xl font-bold text-stone-800 mb-4">I Nostri Servizi</h2>
				<div class="w-20 h-1 bg-olive-600 mx-auto"></div>
			</div>
			
			<div class="grid grid-cols-2 md:grid-cols-4 gap-8 mb-16">
				{services.map((service, index) => (
					<div class={`bg-white p-6 rounded-xl shadow-sm text-center hover:shadow-xl transition-all duration-300 hover:-translate-y-2 cursor-default animate-on-scroll group`} style={`transition-delay: ${index * 100}ms;`}>
						<div class="text-olive-600 mb-4 transform transition-transform duration-300 group-hover:scale-110 flex justify-center" aria-hidden="true">
                            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
                                <path stroke-linecap="round" stroke-linejoin="round" d={service.icon} />
                            </svg>
                        </div>
						<h3 class="font-semibold text-stone-800">{service.name}</h3>
					</div>
				))}
			</div>

			<div class="text-center border-t border-stone-200 pt-12 animate-on-scroll">
				<h3 class="text-2xl font-bold text-stone-800 mb-8">Metodi di Pagamento Accettati</h3>
				<div class="flex flex-wrap justify-center gap-6">
					{payments.map(payment => (
						<div class="flex flex-col items-center gap-2 group">
                            <div class="bg-white p-4 rounded-full shadow-sm border border-stone-200 group-hover:border-olive-500 transition-colors group-hover:shadow-md">
                                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-6 h-6 text-stone-600 group-hover:text-olive-600 transition-colors">
                                    <path stroke-linecap="round" stroke-linejoin="round" d={payment.icon} />
                                </svg>
                            </div>
							<span class="text-xs font-medium text-stone-500 group-hover:text-stone-800 transition-colors">
								{payment.name}
							</span>
						</div>
					))}
				</div>
			</div>
		</div>
	</section>

	<!-- Social Section -->
	<section id="social" class="py-20 bg-white">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center animate-on-scroll">
			<h2 class="text-4xl font-bold text-stone-800 mb-4">Seguici sui Social</h2>
			<div class="w-20 h-1 bg-olive-600 mx-auto mb-8"></div>
			<p class="text-xl text-stone-600 mb-10">Rimani aggiornato sulle nostre novità, eventi e piatti speciali!</p>
			
			<a href="https://www.instagram.com/pizzeria_la_terrazza_di_pisano" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-3 bg-gradient-to-r from-purple-600 to-pink-600 text-white px-8 py-4 rounded-full text-lg font-semibold hover:opacity-90 transition-opacity shadow-lg hover:scale-105 transform duration-200">
				<svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
					<path fill-rule="evenodd" d="M12.315 2c2.43 0 2.784.013 3.808.06 1.064.049 1.791.218 2.427.465a4.902 4.902 0 011.772 1.153 4.902 4.902 0 011.153 1.772c.247.636.416 1.363.465 2.427.048 1.067.06 1.407.06 4.123v.08c0 2.643-.012 2.987-.06 4.043-.049 1.064-.218 1.791-.465 2.427a4.902 4.902 0 01-1.153 1.772 4.902 4.902 0 01-1.772 1.153c-.636.247-1.363.416-2.427.465-1.067.048-1.407.06-4.123.06h-.08c-2.643 0-2.987-.012-4.043-.06-1.064-.049-1.791-.218-2.427-.465a4.902 4.902 0 01-1.772-1.153 4.902 4.902 0 01-1.153-1.772c-.247-.636-.416-1.363-.465-2.427-.047-1.024-.06-1.379-.06-3.808v-.63c0-2.43.013-2.784.06-3.808.049-1.064.218-1.791.465-2.427a4.902 4.902 0 011.153-1.772A4.902 4.902 0 015.468 2.53c.636-.247 1.363-.416 2.427-.465C8.901 2.013 9.256 2 11.685 2h.63zm-.081 1.802h-.468c-2.456 0-2.784.011-3.807.058-.975.045-1.504.207-1.857.344-.467.182-.8.398-1.15.748-.35.35-.566.683-.748 1.15-.137.353-.3.882-.344 1.857-.047 1.023-.058 1.351-.058 3.807v.468c0 2.456.011 2.784.058 3.807.045.975.207 1.504.344 1.857.182.466.399.8.748 1.15.35.35.683.566 1.15.748.353.137.882.3 1.857.344 1.054.048 1.37.058 4.041.058h.08c2.597 0 2.917-.01 3.96-.058.976-.045 1.505-.207 1.858-.344.466-.182.8-.398 1.15-.748.35-.35.566-.683.748-1.15.137-.353.3-.882.344-1.857.048-1.055.058-1.37.058-4.041v-.08c0-2.597-.01-2.917-.058-3.96-.045-.976-.207-1.505-.344-1.858a3.097 3.097 0 00-.748-1.15 3.098 3.098 0 00-1.15-.748c-.353-.137-.882-.3-1.857-.344-1.023-.047-1.351-.058-3.807-.058zM12 6.865a5.135 5.135 0 110 10.27 5.135 5.135 0 010-10.27zm0 1.802a3.333 3.333 0 100 6.666 3.333 3.333 0 000-6.666zm5.338-3.205a1.2 1.2 0 110 2.4 1.2 1.2 0 010-2.4z" clip-rule="evenodd" />
				</svg>
				Seguici su Instagram
			</a>
		</div>
	</section>
	<!-- Footer -->
	<Footer />
</Layout>
