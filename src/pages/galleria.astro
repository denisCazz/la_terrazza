---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const images = [
  { src: '/foto1.jpg', alt: 'Pizza nel forno a legna', class: 'md:col-span-1 md:row-span-1' },
  { src: '/foto_orizzontale.jpg', alt: 'Sala interna', class: 'md:col-span-2 md:row-span-2' },
  { src: '/foto2.jpg', alt: 'Dettaglio pizza', class: 'md:col-span-1 md:row-span-1' },
  { src: '/foto3.jpg', alt: 'Esterno del locale', class: 'md:col-span-1 md:row-span-2' },
  { src: '/foto1.jpg', alt: 'Preparazione impasto', class: 'md:col-span-1 md:row-span-1' },
  { src: '/foto2.jpg', alt: 'Pizza gourmet', class: 'md:col-span-1 md:row-span-1' },
];
---

<Layout 
    title="Galleria | Pizzeria Ristorante La Terrazza"
    description="Sfoglia la galleria fotografica della Pizzeria Ristorante La Terrazza. I nostri piatti, il locale e l'atmosfera che ti aspetta."
>
    <Navbar />

    <main class="pt-32 pb-20 bg-stone-50 min-h-screen">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 animate-fade-in">
                <h1 class="text-4xl md:text-5xl font-serif font-bold text-stone-800 mb-4">La Nostra Galleria</h1>
                <div class="w-24 h-1 bg-olive-600 mx-auto mb-6"></div>
                <p class="text-xl text-stone-600 max-w-2xl mx-auto">
                    Un viaggio visivo attraverso i nostri sapori e la nostra atmosfera.
                </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-4 auto-rows-[200px]">
                {images.map((image, index) => (
                    <div 
                        class={`relative group overflow-hidden rounded-xl cursor-pointer shadow-md hover:shadow-xl transition-all duration-300 ${image.class} animate-on-scroll`}
                        onclick={`openCarousel(${index})`}
                    >
                        <img 
                            src={image.src} 
                            alt={image.alt} 
                            class="w-full h-full object-cover transform group-hover:scale-110 transition-transform duration-700"
                        />
                        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 text-white opacity-0 group-hover:opacity-100 transform scale-50 group-hover:scale-100 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7" />
                            </svg>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </main>

    <!-- Carousel Modal -->
    <div id="carousel-modal" class="fixed inset-0 z-[60] bg-black/95 hidden opacity-0 transition-opacity duration-300 flex items-center justify-center">
        <button id="close-carousel" class="absolute top-6 right-6 text-white hover:text-olive-400 transition-colors z-50">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        
        <button id="prev-slide" class="absolute left-4 md:left-8 text-white hover:text-olive-400 transition-colors z-50 p-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
            </svg>
        </button>

        <div class="relative w-full h-full max-w-6xl max-h-[90vh] p-4 flex items-center justify-center">
            <img id="carousel-image" src="" alt="Gallery preview" class="max-w-full max-h-full object-contain rounded-lg shadow-2xl" />
        </div>

        <button id="next-slide" class="absolute right-4 md:right-8 text-white hover:text-olive-400 transition-colors z-50 p-2">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
        </button>
    </div>

    <Footer />

    <script define:vars={{ images }}>
        let currentIndex = 0;
        const modal = document.getElementById('carousel-modal');
        const carouselImage = document.getElementById('carousel-image');
        const closeBtn = document.getElementById('close-carousel');
        const prevBtn = document.getElementById('prev-slide');
        const nextBtn = document.getElementById('next-slide');

        window.openCarousel = (index) => {
            currentIndex = index;
            updateImage();
            modal.classList.remove('hidden');
            // Small delay to allow display:block to apply before opacity transition
            setTimeout(() => {
                modal.classList.remove('opacity-0');
            }, 10);
            document.body.style.overflow = 'hidden'; // Prevent scrolling
        };

        function closeCarousel() {
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
            document.body.style.overflow = '';
        }

        function updateImage() {
            const image = images[currentIndex];
            carouselImage.src = image.src;
            carouselImage.alt = image.alt;
        }

        function nextSlide() {
            currentIndex = (currentIndex + 1) % images.length;
            updateImage();
        }

        function prevSlide() {
            currentIndex = (currentIndex - 1 + images.length) % images.length;
            updateImage();
        }

        closeBtn.addEventListener('click', closeCarousel);
        nextBtn.addEventListener('click', (e) => { e.stopPropagation(); nextSlide(); });
        prevBtn.addEventListener('click', (e) => { e.stopPropagation(); prevSlide(); });
        
        // Close on background click
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeCarousel();
        });

        // Keyboard navigation
        document.addEventListener('keydown', (e) => {
            if (modal.classList.contains('hidden')) return;
            
            if (e.key === 'Escape') closeCarousel();
            if (e.key === 'ArrowRight') nextSlide();
            if (e.key === 'ArrowLeft') prevSlide();
        });
    </script>
</Layout>